# 阿里云 OSS 相册同步配置（复制本文件为 .env 并填写）
# 注意：.env 已被 .gitignore 忽略，请勿提交真实凭据

# OSS 区域，如 oss-cn-hangzhou / oss-cn-beijing / oss-cn-shenzhen
OSS_REGION=oss-cn-hangzhou

# OSS Bucket 名称
OSS_BUCKET=my-bucket

# RAM 子账号 AccessKey（建议使用最小权限 RAM 用户，仅需 ListObjects 权限）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# 可选：自定义 CDN 域名（如 images.example.com，需已绑定到该 bucket 并开启公开读）
# 不填则使用 https://<bucket>.<region>.aliyuncs.com 默认域名
OSS_DOMAIN=

# 可选：OSS 中相册图片所在文件夹前缀（默认 albums）
# 每个相册对应 <OSS_ALBUM_PREFIX>/<相册id>/ 目录
OSS_ALBUM_PREFIX=albums
